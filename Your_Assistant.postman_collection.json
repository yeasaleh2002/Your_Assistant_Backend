  "item": [
    {
      "name": "01 - Health & System",
      "item": [
        {
          "name": "Health Check & Easter Egg",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Verifies service health and returns the Antigravity active easter egg."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Authentication & JWT",
      "item": [
        {
          "name": "Admin Login & Generate JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('jwtToken', jsonData.access_token);",
                  "    console.log('JWT Token saved to collection variable jwtToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@yourassistant.com\",\n  \"password\": \"change_this_password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates against ADMIN_EMAIL and ADMIN_PASSWORD configured in .env and generates a signed JWT token."
          },
          "response": []
        },
        {
          "name": "Get Authenticated Profile (GET /api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Verifies Bearer JWT token and returns authenticated admin profile."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Application Tracking & Core Endpoints",
      "item": [
        {
          "name": "Trigger Scraper & RAG Matching (POST /api/scrape)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/scrape",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scrape"]
            },
            "description": "Triggers multi-source concurrent scraping for 12 hardcoded keywords, filters 24h & geography, computes RAG cosine match against data/resume.txt, and saves jobs with match_score >= 65% for today's date."
          },
          "response": []
        },
        {
          "name": "Get Jobs by Date (GET /api/jobs - Default Today)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs?skip=0&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"],
              "query": [
                {
                  "key": "skip",
                  "value": "0",
                  "description": "Pagination offset"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Items per page"
                }
              ]
            },
            "description": "Retrieve stored jobs scraped on today's date, ordered by match_score descending."
          },
          "response": []
        },
        {
          "name": "Get Jobs for Specific Date (GET /api/jobs?date=YYYY-MM-DD)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs?date={{targetDate}}&skip=0&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"],
              "query": [
                {
                  "key": "date",
                  "value": "{{targetDate}}",
                  "description": "Filter by date (YYYY-MM-DD)"
                },
                {
                  "key": "skip",
                  "value": "0",
                  "description": "Pagination offset"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Items per page"
                }
              ]
            },
            "description": "Retrieve stored jobs scraped on a specified date, ordered by match score descending."
          },
          "response": []
        },
        {
          "name": "Update Application Status (PATCH /api/jobs/{id}/status)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Applied\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "1", "status"]
            },
            "description": "Updates job application tracking status. Allowed values: Pending, Applied, Interview, Rejected."
          },
          "response": []
        },
        {
          "name": "Delete Jobs by Date (DELETE /api/jobs/date/{date})",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/date/{{targetDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "date", "{{targetDate}}"]
            },
            "description": "Deletes all scraped jobs for the specified date (YYYY-MM-DD)."
          },
          "response": []
        },
        {
          "name": "Generate Tailored Resume & PDF by Job ID",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/generate-resume/1",
              "host": ["{{baseUrl}}"],
              "path": ["generate-resume", "1"]
