# Anthropic Claude API Keys (comma-separated for rate-limit rotation)
CLAUDE_KEYS=claude_key_1,claude_key_2

# Google Gemini API Keys (comma-separated for fallback rotation)
GEMINI_KEYS=gemini_key_1,gemini_key_2

# SerpApi Key for automated job scraping
SERPAPI_API_KEY=your_serpapi_api_key_here

# Database URL (defaults to sqlite:///./jobs.db if omitted)
DATABASE_URL=sqlite:///./jobs.db
