# Anthropic Claude API Keys (comma-separated for rate-limit rotation)
CLAUDE_KEYS=claude_key_1,claude_key_2

# Google Gemini API Keys (comma-separated for fallback rotation)
GEMINI_KEYS=gemini_key_1,gemini_key_2

# SerpApi Key for automated job scraping
SERPAPI_API_KEY=your_serpapi_api_key_here

# Database URL (Neon PostgreSQL, MySQL, or SQLite)
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-cloud.us-east-1.aws.neon.tech/neondb?sslmode=require

# ChromaDB Storage
CHROMA_DB_PATH=./chroma_db

# Admin Authentication & JWT Configuration
JWT_SECRET=080c28897f0a23ca02c407685998fc1c6e8197d3997510ba1d49d7f994f628ad
ADMIN_EMAIL=your_email@example.com
ADMIN_PASSWORD=your_secure_password

# Job Search Recency Window in Hours (96 = 4 days for testing; set to 24 for strict 24h)
JOB_SEARCH_HOURS=96

# Minimum Vector RAG Match Score Percentage Cutoff (55.0 = 55% similarity)
MIN_MATCH_SCORE=55.0

# Target Engineering Roles (Comma-separated, editable anytime)
# For Python: only matches FastAPI positions. Includes QA & SDET roles.
TARGET_ROLES="javascript developer, full stack developer, frontend developer, node.js developer, react.js developer, next.js developer, fastapi developer, python developer, qa engineer, sdet, qa automation"

# Server Command Reference:
# uvicorn app.main:app --reload --host 127.0.0.1 --port 8000

